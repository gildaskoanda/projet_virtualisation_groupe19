# Copiez ce fichier vers .env (cp .env.exemple .env) : .env est ignoré par Git (R7).
# Si .env n'existe pas, « vagrant up » en engendre un avec des mots de passe aléatoires.
# GROUPE : sous-réseau 192.168.(55+GROUPE).0/24, de 1 à 8 (plage imposée par VirtualBox).
GROUPE=3
NB_APP=2
# EXTENSIONS=1 : lb2 (E1) et obs (E2) démarrent aussi ; 0 : socle seul (économise ~1,3 Go).
EXTENSIONS=1
DB_USER=resultats
DB_PASSWORD=changeme
DB_NAME=resultats
DB_REPL_USER=replique
DB_REPL_PASSWORD=changeme
GRAFANA_MDP=changeme
# Mot de passe VRRP (8 caractères maximum).
VRRP_PASS=changeme
