# Fins de ligne : LF partout, quel que soit l'OS de l'auteur
* text=auto eol=lf

# Fichiers qui DOIVENT rester en LF (exécutés dans la VM Linux)
*.sh        text eol=lf
*.rb        text eol=lf
Vagrantfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.tpl       text eol=lf
*.service   text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.json     text eol=lf
.env.exemple text eol=lf

# Fichiers binaires : ne jamais toucher
*.png   binary
*.jpg   binary
*.pdf   binary
*.box   binary