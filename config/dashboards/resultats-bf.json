{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Débit — requêtes/s (répartiteur)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(haproxy_frontend_http_requests_total{proxy=\"http_front\"}[30s]))", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Serveurs applicatifs en service (disparaissent à la panne)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "haproxy_server_up", "legendFormat": "{{proxy}}/{{srv}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Charge CPU par machine (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "{{nom}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Charge (load1) par machine",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "node_load1", "legendFormat": "{{nom}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Réseau reçu sur les répartiteurs (b/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{nom=~\"lb[12]\"}[1m])", "legendFormat": "{{nom}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Machines dont les métriques sont collectées",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 7 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [
        { "expr": "sum(up{job=\"node\"})", "refId": "A" }
      ]
    }
  ],
